# bamboo environment variables
# Placeholders only. Never commit real values (SBS-CORE-SEC-002).

# Application name (required)
APP_NAME=bamboo
# Environment (required)
APP_ENV=production
# Encryption key, generated by php artisan key:generate (required)
APP_KEY=
# Debug output, keep false in production (required)
APP_DEBUG=false
# Public URL (required)
APP_URL=http://localhost:8000
# Log channel (optional)
LOG_CHANNEL=stack
# Database driver (required)
DB_CONNECTION=pgsql
# Database host (required)
DB_HOST=127.0.0.1
# Database port (optional)
DB_PORT=5432
# Database name (required)
DB_DATABASE=bamboo
# Database user (required)
DB_USERNAME=app
# Database password (required)
DB_PASSWORD=
# Session store (optional)
SESSION_DRIVER=redis
# Cache store (optional)
CACHE_STORE=redis
# Queue connection, jobs run synchronously (optional)
QUEUE_CONNECTION=sync
# Redis client (optional)
REDIS_CLIENT=phpredis
# Redis host (required)
REDIS_HOST=127.0.0.1
# Redis port (optional)
REDIS_PORT=6379
# Redis password (optional)
REDIS_PASSWORD=
# Mail transport (required)
MAIL_MAILER=smtp
# Mail server host (required)
MAIL_HOST=localhost
# Mail server port (optional)
MAIL_PORT=1025
# Mail username (optional)
MAIL_USERNAME=
# Mail password (optional)
MAIL_PASSWORD=
# Sender address (required)
MAIL_FROM_ADDRESS=hello@example.test
# Sender name (optional)
MAIL_FROM_NAME="${APP_NAME}"
# Stripe publishable key (test mode) (required)
STRIPE_KEY=pk_test_placeholder
# Stripe secret key (test mode) (required)
STRIPE_SECRET=
# Stripe webhook signing secret (required)
STRIPE_WEBHOOK_SECRET=
# Stripe Price ID (test mode) of the Pro plan (required for upgrades)
STRIPE_PRICE=
# Demo account password used by db:seed; random when empty (optional)
DEMO_PASSWORD=
# App name exposed to the frontend build (optional)
VITE_APP_NAME="${APP_NAME}"
