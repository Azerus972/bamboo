{
    "$schema": "https://shipora.dev/schema/shipora.v1.json",
    "schema_version": "1",
    "name": "bamboo",
    "slug": "bamboo",
    "version": "0.1.0",
    "description": "TikTok content planner SaaS starter: plan videos per team, hook ideas, basic stats, Stripe Pro plan.",
    "product_type": "saas-starter",
    "licence": "See LICENSE",
    "sbs": {
        "core": "1.2",
        "stack": "laravel@1.3",
        "product": "saas-starter@1.1"
    },
    "runtime": {
        "name": "php",
        "version": "8.4"
    },
    "framework": {
        "name": "laravel",
        "version": "13",
        "frontend": {
            "name": "vue",
            "version": "3"
        }
    },
    "prerequisites": [
        {
            "name": "composer",
            "version": ">=2.7"
        },
        {
            "name": "npm",
            "version": ">=10"
        }
    ],
    "databases": [
        {
            "engine": "postgresql",
            "version": "16",
            "required": true
        }
    ],
    "services": [
        {
            "name": "redis",
            "kind": "cache",
            "required": true
        },
        {
            "name": "scheduler",
            "kind": "cron",
            "required": false,
            "command": "php artisan schedule:run"
        }
    ],
    "build": {
        "install": [
            "composer install --no-interaction --prefer-dist",
            "cp .env.example .env",
            "php artisan key:generate",
            "php artisan migrate --force",
            "npm ci"
        ],
        "build": [
            "npm run build"
        ],
        "start": "php artisan serve --host=0.0.0.0 --port=8000"
    },
    "tests": {
        "command": "php artisan test"
    },
    "healthcheck": {
        "type": "http",
        "path": "/up",
        "expect_status": 200
    },
    "env": [
        {
            "name": "APP_NAME",
            "required": true,
            "description": "Application name",
            "secret": false,
            "example": "bamboo"
        },
        {
            "name": "APP_ENV",
            "required": true,
            "description": "Environment",
            "secret": false,
            "example": "production"
        },
        {
            "name": "APP_KEY",
            "required": true,
            "description": "Encryption key, generated by php artisan key:generate",
            "secret": true,
            "example": ""
        },
        {
            "name": "APP_DEBUG",
            "required": true,
            "description": "Debug output, keep false in production",
            "secret": false,
            "example": "false"
        },
        {
            "name": "APP_URL",
            "required": true,
            "description": "Public URL",
            "secret": false,
            "example": "http://localhost:8000"
        },
        {
            "name": "DB_CONNECTION",
            "required": true,
            "description": "Database driver",
            "secret": false,
            "example": "pgsql"
        },
        {
            "name": "DB_HOST",
            "required": true,
            "description": "Database host",
            "secret": false,
            "example": "127.0.0.1"
        },
        {
            "name": "DB_DATABASE",
            "required": true,
            "description": "Database name",
            "secret": false,
            "example": "bamboo"
        },
        {
            "name": "DB_USERNAME",
            "required": true,
            "description": "Database user",
            "secret": false,
            "example": "app"
        },
        {
            "name": "DB_PASSWORD",
            "required": true,
            "description": "Database password",
            "secret": true,
            "example": ""
        },
        {
            "name": "REDIS_HOST",
            "required": true,
            "description": "Redis host",
            "secret": false,
            "example": "127.0.0.1"
        },
        {
            "name": "MAIL_MAILER",
            "required": true,
            "description": "Mail transport",
            "secret": false,
            "example": "smtp"
        },
        {
            "name": "MAIL_HOST",
            "required": true,
            "description": "Mail server host",
            "secret": false,
            "example": "localhost"
        },
        {
            "name": "MAIL_FROM_ADDRESS",
            "required": true,
            "description": "Sender address",
            "secret": false,
            "example": "hello@example.test"
        },
        {
            "name": "STRIPE_KEY",
            "required": true,
            "description": "Stripe publishable key (test mode)",
            "secret": false,
            "example": "pk_test_placeholder"
        },
        {
            "name": "STRIPE_SECRET",
            "required": true,
            "description": "Stripe secret key (test mode)",
            "secret": true,
            "example": ""
        },
        {
            "name": "STRIPE_WEBHOOK_SECRET",
            "required": true,
            "description": "Stripe webhook signing secret",
            "secret": true,
            "example": ""
        },
        {
            "name": "LOG_CHANNEL",
            "required": false,
            "description": "Log channel",
            "secret": false,
            "example": "stack"
        },
        {
            "name": "DB_PORT",
            "required": false,
            "description": "Database port",
            "secret": false,
            "example": "5432"
        },
        {
            "name": "SESSION_DRIVER",
            "required": false,
            "description": "Session store",
            "secret": false,
            "example": "redis"
        },
        {
            "name": "CACHE_STORE",
            "required": false,
            "description": "Cache store",
            "secret": false,
            "example": "redis"
        },
        {
            "name": "QUEUE_CONNECTION",
            "required": false,
            "description": "Queue connection, jobs run synchronously",
            "secret": false,
            "example": "sync"
        },
        {
            "name": "REDIS_CLIENT",
            "required": false,
            "description": "Redis client",
            "secret": false,
            "example": "phpredis"
        },
        {
            "name": "REDIS_PORT",
            "required": false,
            "description": "Redis port",
            "secret": false,
            "example": "6379"
        },
        {
            "name": "REDIS_PASSWORD",
            "required": false,
            "description": "Redis password",
            "secret": true,
            "example": ""
        },
        {
            "name": "MAIL_PORT",
            "required": false,
            "description": "Mail server port",
            "secret": false,
            "example": "1025"
        },
        {
            "name": "MAIL_USERNAME",
            "required": false,
            "description": "Mail username",
            "secret": false,
            "example": ""
        },
        {
            "name": "MAIL_PASSWORD",
            "required": false,
            "description": "Mail password",
            "secret": true,
            "example": ""
        },
        {
            "name": "MAIL_FROM_NAME",
            "required": false,
            "description": "Sender name",
            "secret": false,
            "example": "bamboo"
        },
        {
            "name": "STRIPE_PRICE",
            "required": true,
            "description": "Stripe Price ID (test mode) of the Pro plan",
            "secret": false,
            "example": "price_test_placeholder"
        },
        {
            "name": "DEMO_PASSWORD",
            "required": false,
            "description": "Demo account password used by db:seed; random when empty",
            "secret": true,
            "example": ""
        },
        {
            "name": "VITE_APP_NAME",
            "required": false,
            "description": "App name exposed to the frontend build",
            "secret": false,
            "example": "bamboo"
        }
    ],
    "permissions": {
        "filesystem": [
            "storage/",
            "bootstrap/cache/"
        ],
        "network": "outbound",
        "outbound_hosts": [
            "api.stripe.com"
        ]
    },
    "external_services": [
        {
            "name": "Stripe",
            "purpose": "Payments and billing (test mode keys only)",
            "required": true,
            "env": [
                "STRIPE_KEY",
                "STRIPE_SECRET",
                "STRIPE_WEBHOOK_SECRET",
                "STRIPE_PRICE"
            ]
        },
        {
            "name": "Mail",
            "purpose": "Transactional email (SMTP or API mailer)",
            "required": true,
            "env": [
                "MAIL_MAILER",
                "MAIL_HOST",
                "MAIL_FROM_ADDRESS"
            ]
        }
    ]
}
